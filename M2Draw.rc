IDR_MAINFRAME MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "새로 만들기(&N)\tCtrl+N",                ID_FILE_NEW
        MENUITEM "열기(&O)...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "이미지 가져오기(&I)...\tCtrl+Shift+I", ID_FILE_PLACE_IMAGE
        MENUITEM "SVG 내보내기(&E)...\tCtrl+Shift+E", ID_FILE_EXPORT_SVG
        MENUITEM "HTML 내보내기(&H)...",             ID_FILE_EXPORT_HTML
        MENUITEM "닫기(&C)",                      ID_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "인쇄 설정(&R)...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "최근에 사용한 파일",                 ID_FILE_MRU_FILE1,GRAYED
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)",                       ID_APP_EXIT
    END
    POPUP "보기(&V)"
    BEGIN
        POPUP "도구 모음 및 도킹 창(&T)"
        BEGIN
            MENUITEM "<placeholder>",           ID_VIEW_TOOLBAR
        END
        MENUITEM "상태 표시줄(&S)",                 ID_VIEW_STATUS_BAR

        MENUITEM SEPARATOR

        MENUITEM "격자 표시(&G)",                 ID_VIEW_GRID

        MENUITEM SEPARATOR


        MENUITEM SEPARATOR



    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "M2Draw 정보(&A)...",          ID_APP_ABOUT
    END
END

IDR_M2DrawTYPE MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "새로 만들기(&N)\tCtrl+N",                ID_FILE_NEW
        MENUITEM "열기(&O)...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "이미지 가져오기(&I)...\tCtrl+Shift+I", ID_FILE_PLACE_IMAGE
        MENUITEM "SVG 내보내기(&E)...\tCtrl+Shift+E", ID_FILE_EXPORT_SVG
        MENUITEM "HTML 내보내기(&H)...",             ID_FILE_EXPORT_HTML
        MENUITEM "닫기(&C)",                      ID_FILE_CLOSE
        MENUITEM "저장(&S)\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "다른 이름으로 저장(&A)...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "인쇄(&P)...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "인쇄 미리 보기(&V)",              ID_FILE_PRINT_PREVIEW
        MENUITEM "인쇄 설정(&R)...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "최근에 사용한 파일",                 ID_FILE_MRU_FILE1,GRAYED
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)",                       ID_APP_EXIT
    END
    POPUP "편집(&E)"
    BEGIN
        MENUITEM "실행 취소(&U)\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM "다시 실행(&R)\tCtrl+Y",               ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "잘라내기(&T)\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "복사(&C)\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "붙여넣기(&P)\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "오브젝트(&O)"
    BEGIN
        MENUITEM "그룹(&G)\tCtrl+G",                 ID_OBJECT_GROUP
        MENUITEM "그룹 해제(&U)\tCtrl+Shift+G",      ID_OBJECT_UNGROUP
        MENUITEM SEPARATOR
        MENUITEM "맨 앞으로(&F)\tCtrl+Shift+]",       ID_OBJECT_FRONT
        MENUITEM "앞으로(&W)\tCtrl+]",                 ID_OBJECT_FORWARD
        MENUITEM "뒤로(&B)\tCtrl+[",                   ID_OBJECT_BACKWARD
        MENUITEM SEPARATOR
        POPUP "패스파인더(&P)"
        BEGIN
            MENUITEM "합치기(&U)\tCtrl+Shift+U",       ID_BOOLEAN_UNION
            MENUITEM "빼기(&S)\tCtrl+Shift+S",         ID_BOOLEAN_SUBTRACT
            MENUITEM "교차(&I)\tCtrl+Shift+I",         ID_BOOLEAN_INTERSECT
            MENUITEM "제외(&X)\tCtrl+Shift+X",         ID_BOOLEAN_EXCLUDE
            MENUITEM "트림/분할(&T)\tCtrl+Shift+T",   ID_BOOLEAN_TRIM
        END
        MENUITEM "맨 뒤로(&K)\tCtrl+Shift+[",         ID_OBJECT_BACK
        MENUITEM SEPARATOR
        POPUP "클리핑 마스크(&M)"
        BEGIN
            MENUITEM "만들기(&M)\tCtrl+7",               ID_OBJECT_CLIP_MASK
            MENUITEM "해제(&R)\tCtrl+Alt+7",             ID_OBJECT_RELEASE_MASK
        END
        MENUITEM SEPARATOR
        POPUP "패스(&P)"
        BEGIN
            MENUITEM "윤곽선 만들기 (외곽선 확장)(&O)",  ID_PATH_OUTLINE
            MENUITEM "단순화(&S)...",                  ID_PATH_SIMPLIFY
            MENUITEM "방향 반전(&R)",                  ID_PATH_REVERSE
            MENUITEM "연결(Join)(&J)\tCtrl+J",        ID_PATH_JOIN
            MENUITEM SEPARATOR
            MENUITEM "텍스트를 윤곽선으로 변환(&C)",   ID_TEXT_TO_PATH
        END
    END
    POPUP "보기(&V)"
    BEGIN
        POPUP "도구 모음 및 도킹 창(&T)"
        BEGIN
            MENUITEM "<placeholder>",           ID_VIEW_TOOLBAR
        END
        MENUITEM "상태 표시줄(&S)",                 ID_VIEW_STATUS_BAR

        MENUITEM SEPARATOR

        MENUITEM "격자 표시(&G)",                 ID_VIEW_GRID

        MENUITEM SEPARATOR


        MENUITEM SEPARATOR



    END
    POPUP "창(&W)"
    BEGIN
        MENUITEM "새 창(&N)",                 ID_WINDOW_NEW
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "M2Draw 정보(&A)...",          ID_APP_ABOUT
    END
END




IDR_POPUP_EDIT MENU
BEGIN
	POPUP "편집"
	BEGIN
		MENUITEM "잘라내기(&T)\tCtrl+X",            ID_EDIT_CUT
		MENUITEM "복사(&C)\tCtrl+C",           ID_EDIT_COPY
		MENUITEM "붙여넣기(&P)\tCtrl+V",          ID_EDIT_PASTE
    END
END

IDR_POPUP_SORT MENU
BEGIN
    POPUP "정렬"
    BEGIN
        MENUITEM "사전순 정렬(&S)",         ID_SORTING_SORTALPHABETIC
        MENUITEM "형식별 정렬(&T)",               ID_SORTING_SORTBYTYPE
        MENUITEM "액세스별 정렬(&E)",             ID_SORTING_SORTBYACCESS
        MENUITEM "형식별 그룹화(&Y)",              ID_SORTING_GROUPBYTYPE
    END
END

IDR_POPUP_EXPLORER MENU
BEGIN
    POPUP "탐색기"
    BEGIN
        MENUITEM "열기(&O)",                       ID_OPEN
        MENUITEM "연결 프로그램(&W)....",              ID_OPEN_WITH
        MENUITEM SEPARATOR
        MENUITEM "컴파일(&C)",                    ID_DUMMY_COMPILE
        MENUITEM SEPARATOR
        MENUITEM "잘라내기(&T)\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "복사(&C)\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "제거(&R)",                     ID_EDIT_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "속성(&P)...",              ID_PROPERTIES
    END
END

IDR_OUTPUT_POPUP MENU
BEGIN
    POPUP "팝업"
    BEGIN
        MENUITEM "복사(&C)",                       ID_EDIT_COPY
        MENUITEM "지우기(&C)",                      ID_EDIT_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "숨기기(&H)",                       ID_VIEW_OUTPUTWND
    END
END

IDR_HELP_MENU MENU
BEGIN
    MENUITEM "M2Draw 정보(&A)...",          ID_APP_ABOUT
END

